# Copy to .env to override defaults. The API starts without this file.
PORT=3000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Optional. Used only for token-counting endpoints, never for generation.
# Leave blank to use the local tokenizer for that provider.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
